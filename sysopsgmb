<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Weather — Groningen</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#070b14; --bg2:#0a1120;
    --panel:rgba(255,255,255,.035);
    --panel-strong:rgba(8,13,24,.55);
    --border:rgba(255,255,255,.09);
    --text:#f3f6fc; --sub:#aab5cc; --dim:#6a7693;
    --accent:#8fc6ec; --accent-soft:#5b86ad;
    --cold:#6ea8e0; --warm:#e8a44b; --hot:#e0673d;
    --serif:'Cormorant Garamond',Georgia,serif;
    --sans:'Outfit',system-ui,sans-serif;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{width:100%;height:100%;overflow:hidden;font-family:var(--sans);color:var(--text);
    background:radial-gradient(120% 80% at 50% 0%,var(--bg2),var(--bg) 70%);
    -webkit-font-smoothing:antialiased}

  /* Loader */
  #loader{position:fixed;inset:0;z-index:900;background:var(--bg);display:flex;flex-direction:column;
    align-items:center;justify-content:center;transition:opacity .7s,visibility .7s}
  #loader.done{opacity:0;visibility:hidden;pointer-events:none}
  .ld-mark{width:9vw;height:9vw;color:var(--accent);margin-bottom:3vh;animation:float 2.6s ease-in-out infinite}
  @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-1.4vh)}}
  .ld-city{font-family:var(--serif);font-size:7vw;font-weight:400;letter-spacing:.02em}
  .ld-sub{font-size:1.9vw;color:var(--dim);letter-spacing:.34em;text-transform:uppercase;margin-top:1.6vh}
  .ld-spin{width:5vw;height:5vw;border:.4vw solid rgba(255,255,255,.08);border-top-color:var(--accent);
    border-radius:50%;animation:spin .8s linear infinite;margin-top:4vh}
  @keyframes spin{to{transform:rotate(360deg)}}

  #app{width:100vw;height:100vh;display:flex;flex-direction:column;opacity:0;transition:opacity 1s}
  #app.show{opacity:1}

  /* Top bar */
  .topbar{flex-shrink:0;height:5vh;display:flex;align-items:center;justify-content:space-between;padding:0 5vw}
  .loc{display:flex;align-items:center;gap:1.2vw;font-size:2.6vw;font-weight:500;letter-spacing:.01em}
  .loc svg{width:2.6vw;height:2.6vw;color:var(--accent)}
  .topright{display:flex;align-items:baseline;gap:2.4vw}
  .date{font-size:1.85vw;letter-spacing:.3em;color:var(--sub);text-transform:uppercase;font-weight:500}
  .dot{width:.5vw;height:.5vw;border-radius:50%;background:var(--dim);align-self:center}
  .time{font-size:3vw;font-weight:500;letter-spacing:.04em;font-variant-numeric:tabular-nums}

  /* Hero */
  .hero{flex-shrink:0;position:relative;height:45vh;overflow:hidden;
    border-radius:0 0 2.4vw 2.4vw;background:var(--bg2)}
  .hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 42%;
    animation:drift 30s ease-in-out infinite alternate}
  @keyframes drift{from{transform:scale(1)}to{transform:scale(1.04) translate(-.4%,-.3%)}}
  .hero::after{content:'';position:absolute;inset:0;border-radius:inherit;pointer-events:none;
    background:linear-gradient(180deg,rgba(7,11,20,.55) 0%,rgba(7,11,20,.15) 22%,rgba(7,11,20,.35) 58%,rgba(7,11,20,.92) 100%)}
  .hero-inner{position:absolute;inset:0;z-index:2;padding:4vh 5vw 3vh;display:flex;flex-direction:column}
  .hero-label{display:flex;align-items:center;gap:1.6vw;font-size:1.85vw;letter-spacing:.34em;
    text-transform:uppercase;color:var(--sub);font-weight:500}
  .hero-label .sep{width:5vw;height:1px;background:rgba(255,255,255,.35)}
  .hero-cond{font-family:var(--serif);font-size:7.4vw;font-weight:400;line-height:1;margin-top:1.6vh;letter-spacing:.005em}
  .hero-temp{font-family:var(--serif);font-size:24vw;font-weight:300;line-height:.82;letter-spacing:-.02em;margin-top:-.5vh}
  .hero-temp .deg{font-size:.26em;font-weight:400;vertical-align:top;margin-left:.04em;color:var(--sub)}
  .hero-sub{display:flex;gap:4vw;margin-top:1.4vh;flex-wrap:wrap}
  .hs{font-size:2.4vw;font-weight:400}
  .hs b{font-weight:600}
  .hs span{font-size:1.5vw;letter-spacing:.22em;text-transform:uppercase;color:var(--dim);margin-right:.7vw;font-weight:500}

  /* Precip card overlay */
  .precip{position:absolute;left:5vw;right:5vw;bottom:3vh;z-index:3;
    background:var(--panel-strong);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
    border:1px solid var(--border);border-radius:1.8vw;padding:2.4vh 3vw 2vh}
  .precip-head{display:flex;justify-content:space-between;align-items:flex-start;gap:2vw;margin-bottom:1.6vh}
  .precip-title{font-size:1.7vw;letter-spacing:.26em;text-transform:uppercase;color:var(--sub);font-weight:600}
  .precip-subtle{font-size:1.3vw;color:var(--dim);margin-top:.6vh}
  .precip-stats{text-align:right;font-size:1.5vw;color:var(--sub);line-height:1.6;white-space:nowrap}
  .precip-stats b{color:var(--text);font-weight:600;margin-left:.4vw}
  .chart{position:relative;height:13vh}
  .chart .grid{position:absolute;left:0;right:0;height:1px;background:rgba(255,255,255,.07)}
  .chart .glabel{position:absolute;left:-3.6vw;transform:translateY(-50%);font-size:1.1vw;color:var(--dim);width:3vw;text-align:right}
  .bars{position:absolute;left:1vw;right:0;top:0;bottom:0;display:flex;align-items:flex-end;gap:.5%}
  .bar{flex:1;background:linear-gradient(180deg,var(--accent),var(--accent-soft));border-radius:.4vw .4vw 0 0;
    min-height:1px;position:relative;opacity:.8}
  .bar.peak{opacity:1;background:linear-gradient(180deg,#bfe0f5,var(--accent))}
  .bar .plab{position:absolute;top:0;left:50%;transform:translate(-50%,-130%);font-size:1.4vw;font-weight:600;color:var(--accent);white-space:nowrap}
  .xaxis{position:absolute;left:1vw;right:0;bottom:-3vh;display:flex;justify-content:space-between;
    font-size:1.15vw;color:var(--dim);letter-spacing:.04em}

  /* Mid row: radar + 5 day */
  .mid{flex-shrink:0;height:21vh;display:flex;gap:3vw;padding:3vh 5vw 0}
  .card{background:var(--panel);border:1px solid var(--border);border-radius:1.8vw}
  .radar{flex:0 0 31vw;display:flex;flex-direction:column;padding:2.2vh 2vw;align-items:center}
  .radar-head{align-self:flex-start;font-size:1.55vw;letter-spacing:.22em;text-transform:uppercase;color:var(--sub);font-weight:600}
  .radar-map{margin-top:1.4vh;width:26vw;height:26vw;border-radius:1.2vw;overflow:hidden;background:#0c1424;
    border:1px solid var(--border)}
  .radar-map iframe{width:100%;height:100%;border:0;display:block}
  .radar-foot{align-self:flex-start;margin-top:1.2vh;font-size:1.3vw;color:var(--dim);letter-spacing:.04em}

  .fiveday{flex:1;padding:2.2vh 2.4vw;display:flex;flex-direction:column}
  .fd-head{font-size:1.55vw;letter-spacing:.22em;text-transform:uppercase;color:var(--sub);font-weight:600;margin-bottom:.6vh}
  .fd-rows{flex:1;display:flex;flex-direction:column;justify-content:space-around}
  .fd-row{display:flex;align-items:center;gap:1.8vw}
  .fd-icon{width:3vw;height:3vw;color:var(--text);opacity:.85;flex-shrink:0}
  .fd-day{font-size:2.1vw;font-weight:600;width:6vw;letter-spacing:.04em}
  .fd-min{font-size:2.1vw;color:var(--dim);width:5vw;text-align:right;font-variant-numeric:tabular-nums}
  .fd-track{flex:1;height:.9vh;background:rgba(255,255,255,.09);border-radius:1vh;position:relative}
  .fd-bar{position:absolute;top:0;bottom:0;border-radius:1vh;
    background:linear-gradient(90deg,var(--cold),var(--warm))}
  .fd-max{font-size:2.1vw;font-weight:600;width:5vw;font-variant-numeric:tabular-nums}
  .fd-pop{font-size:1.6vw;color:var(--accent);width:5.5vw;text-align:right;font-variant-numeric:tabular-nums}

  /* Hourly */
  .hourly{flex-shrink:0;height:12vh;display:flex;padding:0 4vw;border-top:1px solid var(--border)}
  .hour{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.7vh;
    border-radius:1.4vw;transition:background .3s}
  .hour.now{background:rgba(143,198,236,.07)}
  .h-time{font-size:1.7vw;color:var(--dim);font-weight:600;letter-spacing:.05em}
  .hour.now .h-time{color:var(--accent)}
  .h-icon{width:4.6vw;height:4.6vw;color:var(--text)}
  .h-temp{font-family:var(--serif);font-size:3.6vw;font-weight:400;line-height:1}
  .h-pop{font-size:1.5vw;color:var(--accent);font-variant-numeric:tabular-nums;min-height:1.5vw}

  /* Bottom metrics */
  .metrics{flex:1;display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:1fr 1fr;border-top:1px solid var(--border)}
  .metric{padding:2.4vh 3vw;display:flex;flex-direction:column;justify-content:center;gap:.7vh;
    border-right:1px solid var(--border);border-bottom:1px solid var(--border)}
  .metric:nth-child(3n){border-right:none}
  .metric:nth-child(n+4){border-bottom:none}
  .m-label{display:flex;align-items:center;gap:1.1vw;font-size:1.55vw;letter-spacing:.22em;
    text-transform:uppercase;color:var(--sub);font-weight:600}
  .m-label svg{width:2vw;height:2vw;color:var(--accent);opacity:.85}
  .m-val{font-family:var(--serif);font-size:4.6vw;font-weight:400;line-height:1;display:flex;align-items:baseline;gap:.6vw}
  .m-val .u{font-size:.4em;color:var(--sub);font-family:var(--sans);font-weight:500;letter-spacing:.04em}
  .m-val .arrow{width:2.4vw;height:2.4vw;color:var(--accent)}
  .m-sub{font-size:1.5vw;color:var(--dim);letter-spacing:.03em;display:flex;align-items:center;gap:1.2vw;flex-wrap:wrap}
  .aqi-dot{width:1.4vw;height:1.4vw;border-radius:50%;flex-shrink:0;box-shadow:0 0 1.4vw currentColor}
  .sun-line{display:flex;align-items:center;gap:.5vw}
</style>
</head>
<body>

<div id="loader">
  <svg class="ld-mark" viewBox="0 0 24 24" fill="currentColor"><path d="M6.5 19a4.5 4.5 0 0 1-.5-8.97 6 6 0 0 1 11.66-1.2A4 4 0 0 1 17.5 19h-11z"/></svg>
  <div class="ld-city">Groningen</div>
  <div class="ld-sub">Loading weather</div>
  <div class="ld-spin"></div>
</div>

<div id="app">
  <div class="topbar">
    <div class="loc">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
      <span>Groningen</span>
    </div>
    <div class="topright">
      <span class="date" id="date">—</span>
      <span class="dot"></span>
      <span class="time" id="time">--:--</span>
    </div>
  </div>

  <div class="hero">
    <img id="bgPhoto" src="" alt="">
    <div class="hero-inner">
      <div class="hero-label"><span class="sep"></span>Current weather<span class="sep"></span><span id="condLabel">—</span></div>
      <div class="hero-cond" id="cond">—</div>
      <div class="hero-temp" id="temp">--<span class="deg">°</span></div>
      <div class="hero-sub">
        <div class="hs"><span>Feels like</span><b id="feels">--°</b></div>
        <div class="hs"><span>Today</span><b id="today">--° / --°</b></div>
        <div class="hs"><span>Fahrenheit</span><b id="fahr">--°F</b></div>
      </div>
    </div>

    <div class="precip">
      <div class="precip-head">
        <div>
          <div class="precip-title">Chance of precipitation</div>
          <div class="precip-subtle">Each bar = chance of rain that hour · next 24 hours</div>
        </div>
        <div class="precip-stats">
          <div>Total<b id="pTotal">0 mm</b></div>
          <div>Peak<b id="pPeak">—</b></div>
        </div>
      </div>
      <div class="chart" id="chart"></div>
    </div>
  </div>

  <div class="mid">
    <div class="card radar">
      <div class="radar-head">Buienradar · Groningen</div>
      <div class="radar-map">
        <iframe src="https://gadgets.buienradar.nl/gadget/zoommap/?lat=53.21917&lng=6.56667&overname=2&zoom=11&naam=Groningen&size=2&voor=1" scrolling="no" width="560" height="560" frameborder="no"></iframe>
      </div>
      <div class="radar-foot" id="radarFoot">Buienradar · --:--</div>
    </div>
    <div class="card fiveday">
      <div class="fd-head">Next 5 days</div>
      <div class="fd-rows" id="fdRows"></div>
    </div>
  </div>

  <div class="hourly" id="hourly"></div>

  <div class="metrics">
    <div class="metric">
      <div class="m-label"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2s6 7 6 11a6 6 0 1 1-12 0c0-4 6-11 6-11z"/></svg>Humidity</div>
      <div class="m-val"><span id="humidity">--</span><span class="u">%</span></div>
      <div class="m-sub" id="dewpoint">Dew point --°C</div>
    </div>
    <div class="metric">
      <div class="m-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M8 19l-1 3M12 19l-1 3M16 19l-1 3"/><path d="M6 15a4 4 0 0 1-.4-7.97 5.5 5.5 0 0 1 10.7-1.1A3.6 3.6 0 0 1 16.5 15" fill="currentColor" stroke="none"/></svg>Precipitation</div>
      <div class="m-val"><span id="precNow">--</span><span class="u">%</span></div>
      <div class="m-sub" id="precNote">—</div>
    </div>
    <div class="metric">
      <div class="m-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 8h11a3 3 0 1 0-3-3M3 13h15a3 3 0 1 1-3 3M3 18h9"/></svg>Wind</div>
      <div class="m-val"><span id="windBft">--</span><span class="u">bft</span>
        <svg class="arrow" id="windArrow" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3l5 9h-3v8h-4v-8H7z"/></svg>
      </div>
      <div class="m-sub" id="windNote">—</div>
    </div>
    <div class="metric">
      <div class="m-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.4 1.4M17.6 17.6 19 19M19 5l-1.4 1.4M6.4 17.6 5 19"/></svg>Daylight</div>
      <div class="m-val" id="daylight">--h --m</div>
      <div class="m-sub"><span class="sun-line">↑ <span id="sunrise">--:--</span></span><span class="sun-line">↓ <span id="sunset">--:--</span></span></div>
    </div>
    <div class="metric">
      <div class="m-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="2.6" fill="currentColor" stroke="none"/></svg>Visibility</div>
      <div class="m-val"><span id="visKm">--</span><span class="u">km</span></div>
      <div class="m-sub" id="visNote">—</div>
    </div>
    <div class="metric">
      <div class="m-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 12h7M3 7h11M3 17h9"/><circle cx="17" cy="9" r="2.4"/></svg>Air quality</div>
      <div class="m-val" style="font-size:3.4vw"><span class="aqi-dot" id="aqiDot"></span><span id="aqiLabel">—</span></div>
      <div class="m-sub" id="aqiNote">European AQI · --</div>
    </div>
  </div>
</div>

<script>
(function(){
  'use strict';
  const LAT=53.21917, LON=6.56667;
  const $=id=>document.getElementById(id);

  /* ---------- clock + date ---------- */
  const DAYS=['SUNDAY','MONDAY','TUESDAY','WEDNESDAY','THURSDAY','FRIDAY','SATURDAY'];
  const MON=['JANUARY','FEBRUARY','MARCH','APRIL','MAY','JUNE','JULY','AUGUST','SEPTEMBER','OCTOBER','NOVEMBER','DECEMBER'];
  function tick(){
    const d=new Date();
    $('time').textContent=String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0');
    $('date').textContent=DAYS[d.getDay()]+' '+d.getDate()+' '+MON[d.getMonth()];
  }
  tick(); setInterval(tick,15000);

  /* ---------- SVG weather icons ---------- */
  const CLOUD='<path d="M6.5 18a4.5 4.5 0 0 1-.5-8.97 6 6 0 0 1 11.66-1.2A4 4 0 0 1 17.5 18h-11z" fill="currentColor"/>';
  function icon(c,day){
    const sun='<g><circle cx="12" cy="11" r="4" fill="currentColor"/><g stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><line x1="12" y1="1.5" x2="12" y2="4"/><line x1="12" y1="18" x2="12" y2="20.5"/><line x1="2" y1="11" x2="4.5" y2="11"/><line x1="19.5" y1="11" x2="22" y2="11"/><line x1="4.8" y1="3.8" x2="6.5" y2="5.5"/><line x1="17.5" y1="16.5" x2="19.2" y2="18.2"/><line x1="4.8" y1="18.2" x2="6.5" y2="16.5"/><line x1="17.5" y1="5.5" x2="19.2" y2="3.8"/></g></g>';
    const moon='<path d="M20 13.5A7.5 7.5 0 1 1 10.5 4a6 6 0 0 0 9.5 9.5z" fill="currentColor"/>';
    switch(c){
      case 'clear': return day?sun:moon;
      case 'partly':
        return '<g><g transform="translate(3.5,-2) scale(.5)">'+(day?
          '<circle cx="12" cy="11" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="12" y1="0" x2="12" y2="3"/><line x1="0" y1="11" x2="3" y2="11"/><line x1="3" y1="3" x2="5" y2="5"/><line x1="21" y1="3" x2="19" y2="5"/></g>'
          :'<path d="M20 13.5A7.5 7.5 0 1 1 10.5 4a6 6 0 0 0 9.5 9.5z" fill="currentColor"/>')+
          '</g><path d="M6 19.5a3.8 3.8 0 0 1-.4-7.6 5.2 5.2 0 0 1 10.1-1A3.4 3.4 0 0 1 16 19.5H6z" fill="currentColor"/></g>';
      case 'fog':
        return '<g stroke="currentColor" stroke-width="1.9" stroke-linecap="round" fill="none"><line x1="4" y1="8" x2="20" y2="8"/><line x1="3" y1="12" x2="18" y2="12"/><line x1="6" y1="16" x2="21" y2="16"/><line x1="4" y1="20" x2="15" y2="20"/></g>';
      case 'drizzle':
        return '<g><path d="M6.5 15a4.5 4.5 0 0 1-.5-8.97 6 6 0 0 1 11.66-1.2A4 4 0 0 1 17.5 15h-11z" fill="currentColor"/><g stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><line x1="8" y1="17.5" x2="7.6" y2="19"/><line x1="12" y1="17.5" x2="11.6" y2="19"/><line x1="16" y1="17.5" x2="15.6" y2="19"/></g></g>';
      case 'rain':
        return '<g><path d="M6.5 15a4.5 4.5 0 0 1-.5-8.97 6 6 0 0 1 11.66-1.2A4 4 0 0 1 17.5 15h-11z" fill="currentColor"/><g stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><line x1="8" y1="17" x2="7" y2="20.5"/><line x1="12" y1="17" x2="11" y2="20.5"/><line x1="16" y1="17" x2="15" y2="20.5"/></g></g>';
      case 'snow':
        return '<g><path d="M6.5 15a4.5 4.5 0 0 1-.5-8.97 6 6 0 0 1 11.66-1.2A4 4 0 0 1 17.5 15h-11z" fill="currentColor"/><g fill="currentColor"><circle cx="8" cy="18.5" r="1.1"/><circle cx="12" cy="20" r="1.1"/><circle cx="16" cy="18.5" r="1.1"/></g></g>';
      case 'thunder':
        return '<g><path d="M6.5 14a4.5 4.5 0 0 1-.5-8.97 6 6 0 0 1 11.66-1.2A4 4 0 0 1 17.5 14h-11z" fill="currentColor"/><path d="M12.5 13l-3.2 5H12l-1 4 4-6h-2.6l1.1-3z" fill="currentColor"/></g>';
      default: return CLOUD;
    }
  }
  function svg(c,day,cls){return '<svg class="'+cls+'" viewBox="0 0 24 24">'+icon(c,day)+'</svg>';}

  /* ---------- WMO mapping ---------- */
  function cat(code){
    if(code>=95) return 'thunder';
    if((code>=71&&code<=77)||code>=85) return 'snow';
    if((code>=61&&code<=67)||code>=80) return 'rain';
    if(code>=51&&code<=57) return 'drizzle';
    if(code===45||code===48) return 'fog';
    if(code===2) return 'partly';
    if(code===3) return 'cloudy';
    return 'clear';
  }
  const DESC={0:'Clear sky',1:'Mainly clear',2:'Partly cloudy',3:'Overcast',45:'Fog',48:'Rime fog',
    51:'Light drizzle',53:'Drizzle',55:'Dense drizzle',56:'Freezing drizzle',57:'Freezing drizzle',
    61:'Light rain',63:'Rain',65:'Heavy rain',66:'Freezing rain',67:'Freezing rain',
    71:'Light snow',73:'Snow',75:'Heavy snow',77:'Snow grains',
    80:'Light showers',81:'Showers',82:'Heavy showers',85:'Snow showers',86:'Heavy snow showers',
    95:'Thunderstorm',96:'Thunderstorm, hail',99:'Severe thunderstorm'};
  function desc(c){return DESC[c]||'—';}

  /* ---------- helpers ---------- */
  function bft(kmh){const t=[1,6,12,20,29,39,50,62,75,89,103,118];let b=0;for(let i=0;i<t.length;i++){if(kmh>=t[i])b=i+1;}return b;}
  const COMPASS=['N','NE','E','SE','S','SW','W','NW'];
  function compass(deg){return COMPASS[Math.round(deg/45)%8];}
  function hhmm(iso){const d=new Date(iso);return String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0');}
  function dewpoint(t,rh){const a=17.625,b=243.04;const g=Math.log(Math.max(rh,1)/100)+(a*t)/(b+t);return Math.round((b*g)/(a-g));}
  function visText(km){if(km>=40)return 'Perfect clarity';if(km>=20)return 'Excellent visibility';if(km>=10)return 'Good visibility';if(km>=4)return 'Moderate haze';if(km>=1)return 'Poor visibility';return 'Foggy';}
  function aqiBand(v){
    if(v<=20)return{l:'Good',c:'#6bbf59'};
    if(v<=40)return{l:'Fair',c:'#d6c84a'};
    if(v<=60)return{l:'Moderate',c:'#f0a93b'};
    if(v<=80)return{l:'Poor',c:'#e8663d'};
    if(v<=100)return{l:'Very poor',c:'#c0392b'};
    return{l:'Extremely poor',c:'#8e44ad'};
  }

  /* ---------- weather photos ---------- */
  const U=(id,x='')=>'https://images.unsplash.com/photo-'+id+'?w=2560&h=1600&fit=crop&auto=format%2Ccompress&q=88'+x;
  const PHOTOS={
    clear_day:[U('1506905925346-21bda4d32df4'),U('1470252649378-9c29740c9fa8'),U('1500382017468-9049fed747ef'),U('1444090695725-d49bd5039e76')],
    clear_night:[U('1519681393784-d120267933ba'),U('1444703686981-a3abbc4d4fe3'),U('1532978379173-523e16f371f2')],
    cloudy_day:[U('1501630834273-4b5604d2ee31','&crop=entropy'),U('1499956827185-0d63ee78a910'),U('1469365556835-3da3db4c253b')],
    cloudy_night:[U('1513628253939-010e64ac66cd'),U('1501511795728-df99c6904cef')],
    rain_day:[U('1428592097671-29a5b7039748'),U('1534274988757-a28bf1a57c17'),U('1433863448220-78aaa30afae7')],
    rain_night:[U('1501999635878-71cb5379c2d8'),U('1415459340527-0e1f3a1eb947')],
    snow_day:[U('1491002052546-bf38f186af56'),U('1418985991508-e47386d96a71'),U('1477601263568-180e2c6d046e')],
    snow_night:[U('1548266652-99cf27701ced'),U('1482841628122-9080d44bb807')],
    fog:[U('1487621167305-5d248087c724'),U('1543968996-ee822b8176ba'),U('1485236715568-ddc5ee6ca227')],
    storm:[U('1461511669078-d46bf351cd6e'),U('1429552077091-836152271555'),U('1472145246862-b24cf25c4a36')]
  };
  function photoKey(code,day){
    if(code>=95)return 'storm';
    if((code>=71&&code<=77)||code>=85)return day?'snow_day':'snow_night';
    if((code>=51&&code<=67)||code>=80)return day?'rain_day':'rain_night';
    if(code===45||code===48)return 'fog';
    if(code>=2)return day?'cloudy_day':'cloudy_night';
    return day?'clear_day':'clear_night';
  }
  function pickPhoto(k){const l=PHOTOS[k]||PHOTOS.cloudy_day;return l[new Date().getHours()%l.length];}

  /* ---------- fetch ---------- */
  async function getForecast(){
    const u='https://api.open-meteo.com/v1/forecast?latitude='+LAT+'&longitude='+LON
      +'&current=temperature_2m,relative_humidity_2m,apparent_temperature,is_day,weather_code,wind_speed_10m,wind_direction_10m,wind_gusts_10m'
      +'&hourly=temperature_2m,weather_code,precipitation_probability,precipitation,is_day,visibility'
      +'&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,sunrise,sunset,daylight_duration'
      +'&timezone=Europe%2FAmsterdam&forecast_days=6';
    const r=await fetch(u); if(!r.ok) throw new Error('forecast '+r.status); return r.json();
  }
  async function getAir(){
    try{
      const u='https://air-quality-api.open-meteo.com/v1/air-quality?latitude='+LAT+'&longitude='+LON+'&current=european_aqi&timezone=Europe%2FAmsterdam';
      const r=await fetch(u); if(!r.ok) throw 0; return r.json();
    }catch(e){return null;}
  }

  /* ---------- render ---------- */
  function render(d,air){
    const c=d.current, day=c.is_day===1, h=d.hourly, dl=d.daily;
    const code=c.weather_code;

    $('bgPhoto').src=pickPhoto(photoKey(code,day));
    $('condLabel').textContent=desc(code);
    $('cond').textContent=desc(code);
    $('temp').innerHTML=Math.round(c.temperature_2m)+'<span class="deg">°</span>';
    $('feels').textContent=Math.round(c.apparent_temperature)+'°';
    $('today').textContent=Math.round(dl.temperature_2m_max[0])+'° / '+Math.round(dl.temperature_2m_min[0])+'°';
    $('fahr').textContent=Math.round(c.temperature_2m*9/5+32)+'°F';

    const now=new Date();
    let ci=h.time.findIndex(t=>{const x=new Date(t);return x.getDate()===now.getDate()&&x.getHours()===now.getHours();});
    if(ci<0)ci=0;

    /* precip chart — next 24h */
    const chart=$('chart'); chart.innerHTML='';
    [0,50,100].forEach(p=>{
      const g=document.createElement('div'); g.className='grid'; g.style.bottom=p+'%';
      const lab=document.createElement('div'); lab.className='glabel'; lab.style.bottom=p+'%'; lab.textContent=p+'%';
      chart.appendChild(g); chart.appendChild(lab);
    });
    const bars=document.createElement('div'); bars.className='bars';
    let peak=0,peakIdx=0,total=0;
    for(let i=0;i<24;i++){
      const idx=ci+i; const pr=(h.precipitation_probability&&h.precipitation_probability[idx])||0;
      total+=(h.precipitation&&h.precipitation[idx])||0;
      if(pr>peak){peak=pr;peakIdx=i;}
    }
    for(let i=0;i<24;i++){
      const idx=ci+i; const pr=(h.precipitation_probability&&h.precipitation_probability[idx])||0;
      const b=document.createElement('div'); b.className='bar'+(i===peakIdx&&peak>0?' peak':'');
      b.style.height=Math.max(pr,1.5)+'%';
      if(i===peakIdx&&peak>0){const l=document.createElement('div');l.className='plab';l.textContent=peak+'%';b.appendChild(l);}
      bars.appendChild(b);
    }
    chart.appendChild(bars);
    const xa=document.createElement('div'); xa.className='xaxis';
    [0,6,12,18,23].forEach(i=>{
      const s=document.createElement('span');
      const t=new Date(h.time[ci+i]);
      s.textContent=(i===0?'Now':String(t.getHours()).padStart(2,'0')+':00');
      xa.appendChild(s);
    });
    chart.appendChild(xa);
    $('pTotal').textContent=(total<0.05?'0':total.toFixed(1))+' mm';
    $('pPeak').textContent=peak>0?(peak+'% at '+String(new Date(h.time[ci+peakIdx]).getHours()).padStart(2,'0')+':00'):'0%';

    $('radarFoot').textContent='Buienradar · '+$('time').textContent;

    /* 5-day */
    const SD=['SUN','MON','TUE','WED','THU','FRI','SAT'];
    const rows=$('fdRows'); rows.innerHTML='';
    let gMin=Infinity,gMax=-Infinity;
    for(let i=1;i<=5;i++){gMin=Math.min(gMin,dl.temperature_2m_min[i]);gMax=Math.max(gMax,dl.temperature_2m_max[i]);}
    const sp=(gMax-gMin)||1;
    for(let i=1;i<=5;i++){
      const dd=new Date(dl.time[i]);
      const mn=dl.temperature_2m_min[i], mx=dl.temperature_2m_max[i];
      const left=((mn-gMin)/sp)*100, width=Math.max(((mx-mn)/sp)*100,6);
      const pop=dl.precipitation_probability_max[i];
      const row=document.createElement('div'); row.className='fd-row';
      row.innerHTML=svg(cat(dl.weather_code[i]),true,'fd-icon')
        +'<span class="fd-day">'+SD[dd.getDay()]+'</span>'
        +'<span class="fd-min">'+Math.round(mn)+'°</span>'
        +'<span class="fd-track"><span class="fd-bar" style="left:'+left+'%;width:'+width+'%"></span></span>'
        +'<span class="fd-max">'+Math.round(mx)+'°</span>'
        +'<span class="fd-pop">'+(pop!=null?pop+'%':'')+'</span>';
      rows.appendChild(row);
    }

    /* hourly strip */
    const hr=$('hourly'); hr.innerHTML='';
    const nowCell=document.createElement('div'); nowCell.className='hour now';
    nowCell.innerHTML='<span class="h-time">NOW</span>'+svg(cat(code),day,'h-icon')
      +'<span class="h-temp">'+Math.round(c.temperature_2m)+'°</span><span class="h-pop"></span>';
    hr.appendChild(nowCell);
    for(let i=1;i<=8;i++){
      const idx=ci+i; if(idx>=h.time.length)break;
      const t=new Date(h.time[idx]);
      const pr=(h.precipitation_probability&&h.precipitation_probability[idx]);
      const cell=document.createElement('div'); cell.className='hour';
      cell.innerHTML='<span class="h-time">'+String(t.getHours()).padStart(2,'0')+':00</span>'
        +svg(cat(h.weather_code[idx]),h.is_day[idx]===1,'h-icon')
        +'<span class="h-temp">'+Math.round(h.temperature_2m[idx])+'°</span>'
        +'<span class="h-pop">'+(pr!=null&&pr>0?pr+'%':'')+'</span>';
      hr.appendChild(cell);
    }

    /* metrics */
    $('humidity').textContent=Math.round(c.relative_humidity_2m);
    $('dewpoint').textContent='Dew point '+dewpoint(c.temperature_2m,c.relative_humidity_2m)+'°C';

    const precNow=(h.precipitation_probability&&h.precipitation_probability[ci])||0;
    let maxNext=0; for(let i=0;i<12;i++){const v=(h.precipitation_probability&&h.precipitation_probability[ci+i])||0;if(v>maxNext)maxNext=v;}
    $('precNow').textContent=precNow;
    $('precNote').textContent=maxNext<30?'Dry weather expected':(maxNext<60?'Showers possible':'Rain expected');

    $('windBft').textContent=bft(c.wind_speed_10m);
    $('windArrow').style.transform='rotate('+((c.wind_direction_10m+180)%360)+'deg)';
    $('windNote').textContent=compass(c.wind_direction_10m)+' · gusts '+Math.round(c.wind_gusts_10m)+' km/h';

    const secs=dl.daylight_duration[0]; const dh=Math.floor(secs/3600), dm=Math.round((secs%3600)/60);
    $('daylight').innerHTML=dh+'<span class="u">h</span> '+dm+'<span class="u">m</span>';
    $('sunrise').textContent=hhmm(dl.sunrise[0]);
    $('sunset').textContent=hhmm(dl.sunset[0]);

    const visM=(h.visibility&&h.visibility[ci]); const visKm=visM!=null?Math.round(visM/1000):'--';
    $('visKm').textContent=visKm;
    $('visNote').textContent=visM!=null?visText(visKm):'—';

    if(air&&air.current&&air.current.european_aqi!=null){
      const v=Math.round(air.current.european_aqi); const a=aqiBand(v);
      $('aqiLabel').textContent=a.l;
      $('aqiDot').style.background=a.c; $('aqiDot').style.color=a.c;
      $('aqiNote').textContent='European AQI · '+v;
    }else{
      $('aqiLabel').textContent='—'; $('aqiNote').textContent='European AQI · --';
    }
  }

  async function init(){
    try{
      const res=await Promise.all([getForecast(),getAir()]);
      render(res[0],res[1]);
      $('loader').classList.add('done');
      $('app').classList.add('show');
    }catch(e){
      console.error(e);
      document.querySelector('.ld-sub').textContent='Retrying…';
      setTimeout(init,10000);
    }
  }
  init();
  setInterval(async()=>{try{const res=await Promise.all([getForecast(),getAir()]);render(res[0],res[1]);}catch(e){}},600000);
})();
</script>
</body>
</html>
